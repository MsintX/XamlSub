                                <TextBlock Text="FontStyle（字体样式）"/>
                                <ComboBox x:Name="FontStyleBox" Tag="FontStyle" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Normal"/>
                                    <ComboBoxItem Content="Italic"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="TextAlignment（文本对齐）"/>
                                <ComboBox x:Name="TextAlignmentBox" Tag="TextAlignment" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Left"/>
                                    <ComboBoxItem Content="Center"/>
                                    <ComboBoxItem Content="Right"/>
                                    <ComboBoxItem Content="Justify"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FlowDirection（文本流向）"/>
                                <ComboBox x:Name="FlowDirectionBox" Tag="FlowDirection" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="LeftToRight"/>
                                    <ComboBoxItem Content="RightToLeft"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="TabIndex（Tab 顺序）"/>
                                <TextBox x:Name="TabIndexBox" Tag="TabIndex" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="UseSystemFocusVisuals（系统焦点视觉）"/>
                                <ComboBox x:Name="UseSystemFocusVisualsBox" Tag="UseSystemFocusVisuals" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Command（命令）"/>
                                <TextBox x:Name="CommandBox" Tag="Command" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CommandParameter（命令参数）"/>
                                <TextBox x:Name="CommandParameterBox" Tag="CommandParameter" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="IsDefault（默认按钮）"/>
                                <ComboBox x:Name="IsDefaultBox" Tag="IsDefault" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IsCancel（取消按钮）"/>
                                <ComboBox x:Name="IsCancelBox" Tag="IsCancel" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="ClickMode（点击模式）"/>
                                <ComboBox x:Name="ClickModeBox" Tag="ClickMode" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Release"/>
                                    <ComboBoxItem Content="Press"/>
                                    <ComboBoxItem Content="Hover"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IsIndeterminate（不确定进度）"/>
                                <ComboBox x:Name="IsIndeterminateBox" Tag="IsIndeterminate" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="DateFormat（日期格式）"/>
                                <TextBox x:Name="DateFormatBox" Tag="DateFormat" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="NumberFormat（数字格式）"/>
                                <TextBox x:Name="NumberFormatBox" Tag="NumberFormat" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Language（语言）"/>
                                <TextBox x:Name="LanguageBox" Tag="Language" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Tag（自定义标签）"/>
                                <TextBox x:Name="TagBox" Tag="Tag" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="事件（Event - 事件处理）" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="EventText" Text="—" TextWrapping="Wrap"/>
                        <Button x:Name="DeleteButton" Content="删除控件" Click="DeleteSelected_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="SettingsWorkspace" Visibility="Collapsed" Background="Transparent">
            <NavigationView x:Name="SettingsNavigation"
                            PaneDisplayMode="LeftCompact"
                            IsPaneOpen="False"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            Background="Transparent"
                            SelectionChanged="SettingsNavigation_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="SettingsGeneralItem" Content="通用" Tag="General" IsSelected="True">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Setting"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="设计" Tag="Design">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Edit"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="实验性" Tag="Experimental">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE943;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="关于" Tag="About">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Help"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.Content>
                    <Grid x:Name="SettingsContentRoot" Padding="28" Background="{ThemeResource DesignerCardBackgroundBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ContentControl x:Name="SettingsPageHost"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"/>
                        </ScrollViewer>

                        <Grid x:Name="SettingsPagePool" Visibility="Collapsed">
                                <StackPanel x:Name="GeneralSettingsPanel" Spacing="14">
                                    <TextBlock Text="通用" FontSize="28" FontWeight="SemiBold"/>
                                    <TextBlock Text="应用程序窗口的显示效果与常用行为" Opacity="0.72" TextWrapping="Wrap"/>
                                    <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="应用窗口材质" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="选择窗口使用的系统背景材质" Opacity="0.68" TextWrapping="Wrap"/>
                                            <ComboBox x:Name="WindowBackdropBox" Tag="WindowBackdrop" SelectionChanged="SettingsCombo_SelectionChanged">
                                                <ComboBoxItem Content="Mica（云母）"/>
                                                <ComboBoxItem Content="Acrylic（亚克力）" Tag="Acrylic"/>
                                                <ComboBoxItem Content="None"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="自动保存" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="添加控件或修改元素后自动写回 XAML" Opacity="0.68" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="AutoSaveToggle" Grid.Column="1" IsOn="False" Toggled="AutoSaveToggle_Toggled" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="宽泛的保存检查" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="没有 x:Class 或其他明确关联时，只要同目录存在同名 .xaml.cs，也允许将事件代码保存到该 C# 文件" Opacity="0.68" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="BroadSaveCheckToggle" Grid.Column="1" IsOn="False" Toggled="BroadSaveCheckToggle_Toggled" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="DesignSettingsPanel" Spacing="14">
                                    <TextBlock Text="设计" FontSize="28" FontWeight="SemiBold"/>
                                    <TextBlock Text="选择设计器的定位模型，并切换对应的可视化辅助工具" Opacity="0.72" TextWrapping="Wrap"/>
                                    <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="定位方式" FontSize="16" FontWeight="SemiBold"/>
                                            <ComboBox x:Name="PositioningModeBox" Tag="PositioningMode" SelectionChanged="SettingsCombo_SelectionChanged">
                                                <ComboBoxItem Content="相对定位"/>
                                                <ComboBoxItem Content="绝对坐标"/>
                                            </ComboBox>
                                            <StackPanel x:Name="RelativeStrategyPanel" Spacing="6">
                                                <TextBlock Text="相对定位方式"/>
                                                <ComboBox x:Name="RelativeStrategyBox" Tag="RelativeStrategy" SelectionChanged="SettingsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="FreedomPanel(非原生XAML标签)" Tag="自定义 Panel"/>
                                                    <ComboBoxItem Content="DockPanel"/>
                                                    <ComboBoxItem Content="Grid"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel x:Name="AbsoluteStrategyPanel" Spacing="6" Visibility="Collapsed">
                                                <TextBlock Text="绝对坐标方式"/>
                                                <ComboBox x:Name="AbsoluteStrategyBox" Tag="AbsoluteStrategy" SelectionChanged="SettingsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Canvas"/>
                                                    <ComboBoxItem Content="Grid 中使用 Margin 负值"/>
                                                    <ComboBoxItem Content="Grid 中使用精确值"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="ExperimentalSettingsPanel" Spacing="14" MaxWidth="760">
                                    <TextBlock Text="实验性" FontSize="28" FontWeight="SemiBold"/>
                                    <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="高保真预览（编辑器覆盖层）" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="预览现在直接使用真实的 WinUI 控件树，选择、拖动、辅助线等设计器交互独立放在 Overlay 覆盖层！" Opacity="0.68" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="HighFidelityPreviewToggle" Grid.Column="1" IsOn="False" IsEnabled="True" VerticalAlignment="Center" Toggled="HighFidelityPreviewToggle_Toggled"/>
                                        </Grid>
                                    </Border>
                                    <InfoBar IsOpen="True" Severity="Informational"
                                             Title="实验性功能提醒"
                                             Message="这些功能仍在测试中，甚至可能处于半成品状态！除非你从（或开启这些选项的时间内）不进行正式/重要开发，否则并不应该开启这里的任何功能！"/>
                                </StackPanel>

                                <StackPanel x:Name="AboutSettingsPanel" Spacing="18" MaxWidth="760" Visibility="Visible">
                                    <StackPanel Spacing="18" MaxWidth="760">
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <Image Source="ms-appx:///Assets/Square150x150Logo.png" Width="88" Height="88" Stretch="UniformToFill"/>
                                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="XAML Sub" FontSize="30" FontWeight="SemiBold"/>
                                                <TextBlock Text="独立于 Visual Studio 的轻量级 WinUI XAML 可视化编辑器" Opacity="0.72" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="借物表" FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock TextWrapping="Wrap">
            <Run Text="• Microsoft WinUI 3 / Windows App SDK"/>
            <LineBreak/>
            <Run Text="• Microsoft Roslyn（C# 语法分析与格式化）"/>
            <LineBreak/>
            <Run Text="• Visual Studio / .NET 工具链"/>
            <LineBreak/>
            <Run Text="• 项目 Assets 文件夹中的应用图标资源"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="特别鸣谢" FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock TextWrapping="Wrap" LineHeight="22">
            <Run Text="• " FontWeight="SemiBold"/>
            <Run Text="Microsoft WinUI 3 / Windows App SDK 团队" FontWeight="SemiBold"/>
            <Run Text=" - 提供 TitleBar、NavigationView、ContentDialog、MicaBackdrop、DesktopAcrylicBackdrop、AppBarButton、NumberBox、InfoBar 等全部 UI 框架与控件库"/>
            <LineBreak/>
            <Run Text="• " FontWeight="SemiBold"/>
            <Run Text="Microsoft .NET / Roslyn 团队" FontWeight="SemiBold"/>
            <Run Text=" - 提供 C# 语言、语法分析与代码格式化（事件代码写回 .xaml.cs 依赖此能力）"/>
            <LineBreak/>
            <Run Text="• " FontWeight="SemiBold"/>
            <Run Text="Microsoft Visual Studio / .NET 工具链团队" FontWeight="SemiBold"/>
            <Run Text=" - 提供 .csproj 解析、XAML 写回与整套开发调试工具链"/>
            <LineBreak/>
            <Run Text="• " FontWeight="SemiBold"/>
            <Run Text="Microsoft Windows App SDK 窗口化 / 标题栏互操作团队" FontWeight="SemiBold"/>
            <Run Text=" - 提供 ExtendsContentIntoTitleBar、SetTitleBar、InitializeWithWindow、WindowNative.GetWindowHandle，让 WinUI 3 能作为独立桌面应用运行"/>
            <LineBreak/>
            <Run Text="• " FontWeight="SemiBold"/>
            <Run Text="Microsoft XAML / WinUI 标记与解析团队" FontWeight="SemiBold"/>
            <Run Text=" - 提供 XAML 语言与 Microsoft.UI.Xaml.Markup，让 XAML 能被读取、生成与写回"/>
            <LineBreak/>
            <Run Text="• " FontWeight="SemiBold"/>
            <Run Text="Microsoft Windows 文件选择器 / DataTransfer 团队" FontWeight="SemiBold"/>
            <Run Text=" - 提供 FileOpenPicker、StorageFile、Windows.ApplicationModel.DataTransfer，支撑打开文件与拖拽放置控件"/>
            <LineBreak/>
            <Run Text="• " FontWeight="SemiBold"/>
            <Run Text="Microsoft Windows Composition / 动画团队" FontWeight="SemiBold"/>
            <Run Text=" - 提供 Storyboard、DoubleAnimation、CubicEase、ContentThemeTransition，支撑工作区切换与返回按钮展开动画"/>
            <LineBreak/>
            <Run Text="• " FontWeight="SemiBold"/>
            <Run Text="Microsoft Windows 无障碍 / Automation 团队" FontWeight="SemiBold"/>
            <Run Text=" - 提供 AutomationProperties，支撑返回按钮等控件的无障碍标注"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="16" CornerRadius="8" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="开发作者" FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock Text="MisntX" FontSize="20" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                        </Grid>
                    </Grid>
                </NavigationView.Content>
            </NavigationView>
        </Grid>
        </Grid>
        <Border Grid.Row="3" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="10" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusText" Text="未打开文件"/>
                <TextBlock Grid.Column="1" x:Name="HintText" Text="Tip: 正在准备提示…" Opacity="0.5" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
